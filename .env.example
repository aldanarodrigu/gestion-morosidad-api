# Copiar a .env y completar. .env está en .gitignore: NUNCA commitearlo.
# Este archivo SÍ se commitea: no poner valores reales acá.

# Base de datos. Para Supabase (Session Pooler) usar el host/usuario del panel y DB_SSLMODE=require.
# Para el Postgres local del docker-compose: DB_HOST=localhost, DB_PORT=5433, DB_SSLMODE=prefer.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Credenciales de la API GeoPagos (entregadas por la Intendencia, pedirlas al equipo)
UTEC_API_USERNAME=
UTEC_API_PASSWORD=
# Registros por pagina para GeoPagos y GeoPat (1 a 1000).
UTEC_API_PAGE_SIZE=1000

# Sincronizacion automatica: por defecto diaria a las 03:00 de Uruguay.
SINCRONIZACION_AUTOMATICA=true
SINCRONIZACION_CRON=0 0 3 * * *

# Clave para firmar los JWT. OBLIGATORIA (sin ella la API no arranca).
# Debe estar en Base64 y tener al menos 32 bytes. Generarla en PowerShell con:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Requerida para crear el administrador en una base vacía con el perfil prod (mínimo 15 caracteres).
ADMIN_BOOTSTRAP_PASSWORD=
# Duración de la sesión en segundos (por defecto 3600 = 1 hora).
JWT_EXPIRATION_SECONDS=3600

# Límite de fallos de inicio de sesión por cuenta
LOGIN_MAX_FALLOS=5
# Fallos desde una IP contra cualquier cuenta, y de una cuenta desde todas las IP
LOGIN_MAX_FALLOS_IP=20
LOGIN_MAX_FALLOS_CUENTA=50
LOGIN_VENTANA_SEGUNDOS=900
LOGIN_BLOQUEO_SEGUNDOS=900

# Puertos en la máquina host (cambiarlos si ya están ocupados)
DB_HOST_PORT=5433
API_HOST_PORT=9080
FRONT_HOST_PORT=8000
