# Copiar a .env y completar. .env está en .gitignore: NUNCA commitearlo.
# Este archivo SÍ se commitea: no poner valores reales acá.

# Base de datos. Para Supabase (Session Pooler) usar el host/usuario del panel y DB_SSLMODE=require.
# Para el Postgres local del docker-compose: DB_HOST=localhost, DB_PORT=5433, DB_SSLMODE=prefer.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Credenciales de la API GeoPagos (entregadas por la Intendencia, pedirlas al equipo)
UTEC_API_USERNAME=
UTEC_API_PASSWORD=

# Clave para firmar los JWT. OBLIGATORIA (sin ella la API no arranca).
# Debe estar en Base64 y tener al menos 32 bytes. Generarla en PowerShell con:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Puertos en la máquina host (cambiarlos si ya están ocupados)
DB_HOST_PORT=5433
API_HOST_PORT=9080
FRONT_HOST_PORT=8000
